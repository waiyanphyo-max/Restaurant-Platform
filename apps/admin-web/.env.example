# Local web development. Use the matching HTTPS web and API origins for each deployment.
APP_STAGE=local
ADMIN_WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Supabase project HTTPS origin and public sb_publishable_ key from the same environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# For email onboarding, expose this app through HTTPS, set APP_STAGE=staging for tunnel tests,
# and set ADMIN_WEB_ORIGIN to that public HTTPS origin. APP_STAGE=local accepts HTTP loopback only.
# The API origin above is used by server actions and can remain loopback in local HTTPS tunnel testing.
# Backend SUPABASE_INVITE_REDIRECT_URL must be https://<configured-admin-host>/auth/accept-invite.
# Configure the identical URL in Supabase Auth and use token_hash invite/recovery email templates.
SUPABASE_INVITE_REDIRECT_URL=https://<configured-admin-host>/auth/accept-invite
