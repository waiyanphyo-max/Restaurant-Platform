EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Select one reviewed configs/restaurants/<slug>.json per restaurant-branded binary.
# starter-fixture is allowed ONLY for development/export and contains no live restaurant.
MOBILE_ENV=development
RESTAURANT_SLUG=starter-fixture
PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Android Maps SDK key, visible in the native binary. Leave empty for manual-entry fallback.
# Restrict by exact package name + installed signing certificate SHA-1 and Maps SDK for Android.
# Use separate restricted dev/prod keys in each restaurant's build environment; rebuild after changes.
CUSTOMER_GOOGLE_MAPS_ANDROID_API_KEY=
# Optional reviewed service-area center; neither value is automatically a delivery destination.
CUSTOMER_MAP_INITIAL_LATITUDE=
CUSTOMER_MAP_INITIAL_LONGITUDE=

# Existing-account verified SMS login only. Requires live Supabase provider settings too.
CUSTOMER_PHONE_OTP_ENABLED=false

# Native FCM device registration only; match this client Firebase project to server FCM.
# google-services.json is Android client config, never a server service-account file.
CUSTOMER_NOTIFICATIONS_ENABLED=false
CUSTOMER_GOOGLE_SERVICES_FILE=
