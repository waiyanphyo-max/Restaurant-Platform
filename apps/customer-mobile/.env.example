EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
# Match reviewed Supabase Authentication password policy; existing app floor stays eight.
EXPO_PUBLIC_CUSTOMER_PASSWORD_MIN_LENGTH=8
# Empty, letters_digits, lower_upper_letters_digits, or lower_upper_letters_digits_symbols.
EXPO_PUBLIC_CUSTOMER_PASSWORD_REQUIREMENTS=
# Enable only after reviewing the shared Reset Password template and including {{ .Token }}.
# Recovery uses the emailed code in-app, without changing existing link redirect workflows.
EXPO_PUBLIC_CUSTOMER_EMAIL_OTP_RECOVERY_ENABLED=false
# Optional reviewed stable guest HTTPS callback; no Quick Tunnel URLs.
# Exact path: https://<reviewed-tenant-host>/auth/customer-confirmation/<environment>/<restaurant-slug>
# Empty uses this binary's existing custom scheme and returns to sign-in.
EXPO_PUBLIC_CUSTOMER_CONFIRMATION_URL=

# Select one reviewed configs/restaurants/<slug>.json per restaurant-branded binary.
# starter-fixture is only for development/export. Reviewed configs carry their own API origin.
MOBILE_ENV=development
RESTAURANT_SLUG=starter-fixture
PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# Optional explicit device-test API origin for development. Set a reachable HTTPS origin,
# or opt in to HTTP for the specific private LAN address used by the phone.
# MOBILE_DEVELOPMENT_API_BASE_URL=
# Set true only for USB adb reverse with http://127.0.0.1:8080.
# MOBILE_ADB_REVERSE_ENABLED=true

# Android Maps SDK key, visible in the native binary. Leave empty for manual-entry fallback.
# Restrict by exact package name + installed signing certificate SHA-1 and Maps SDK for Android.
# Use separate restricted dev/prod keys in each restaurant's build environment; rebuild after changes.
CUSTOMER_GOOGLE_MAPS_ANDROID_API_KEY=
# Optional reviewed service-area center; neither value is automatically a delivery destination.
CUSTOMER_MAP_INITIAL_LATITUDE=
CUSTOMER_MAP_INITIAL_LONGITUDE=

# Existing-account verified SMS login only. Requires live Supabase provider settings too.
CUSTOMER_PHONE_OTP_ENABLED=false

# Native FCM device registration only; match this client Firebase project to server FCM.
# google-services.json is Android client config, never a server service-account file.
CUSTOMER_NOTIFICATIONS_ENABLED=false
CUSTOMER_GOOGLE_SERVICES_FILE=
# For the Restaurant A FCM build, set the intended project ID for both mobile apps.
MOBILE_FIREBASE_PROJECT_ID=
# Suggested ignored path, relative to this app directory.
# CUSTOMER_GOOGLE_SERVICES_FILE=../../target/android-fcm/firebase/customer/google-services.json
