{
  "cli": {
    "version": "27.5.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "22.23.4",
      "autoIncrement": false,
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-58"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "MOBILE_ENV": "development"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      }
    },
    "staging": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "MOBILE_ENV": "staging"
      },
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "env": {
        "MOBILE_ENV": "production"
      },
      "credentialsSource": "local",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
