# Browser-visible API origin. Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public Supabase browser configuration. Find these under Project Settings > API.
# The publishable key is safe for browser use; never use the service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
