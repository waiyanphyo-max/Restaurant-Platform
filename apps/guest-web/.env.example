# Use exact reviewed tenant hosts. Set production on the production deployment.
GUEST_CONFIG_ENV=staging
GUEST_LOCAL_ROUTING=false
# Loopback is for local development. Use the matching HTTPS API origin on deployed web.
GUEST_API_BASE_URL=http://localhost:8080
# Compatibility fallback for other public clients; guest SSR prefers GUEST_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Only needed for Supabase Auth features. Use the project's HTTPS origin and sb_publishable_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
