{
  "name": "@restaurant-platform/restaurant-config",
  "version": "0.1.0",
  "private": true,
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    "./expo": "./expo.cjs",
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./mobile-runtime": {
      "types": "./mobile-runtime.ts",
      "default": "./mobile-runtime.ts"
    }
  },
  "dependencies": {
    "@expo/config-plugins": "58.0.12",
    "@restaurant-platform/shared-types": "0.1.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint *.cjs index.mjs mobile-runtime.ts tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
