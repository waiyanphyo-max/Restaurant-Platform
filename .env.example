# Supabase PostgreSQL connection (server-side only)
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=replace_me

# Supabase Auth JWT validation (use the values for your own project)
SUPABASE_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional application settings
DB_POOL_MAX_SIZE=5
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
APP_SECURITY_JWT_REQUIRED_AUDIENCE=authenticated
# Set to the asymmetric signing algorithm configured for the Supabase project, e.g. ES256 or RS256.
APP_SECURITY_JWT_SIGNING_ALGORITHM=ES256

# Optional QR checkout idempotency. Generate a random 32-byte key and Base64-encode it.
# Required only when a client sends the Idempotency-Key header; keep this secret on the API server.
APP_IDEMPOTENCY_ENCRYPTION_KEY=

# Optional Firebase Cloud Messaging. Do not enable until the API has valid server credentials.
# Either provide application-default credentials in the hosting environment, or the service-account JSON as a secret.
# Never expose this value in a NEXT_PUBLIC_* variable, commit an actual credential, or log it.
APP_PUSH_FIREBASE_ENABLED=false
APP_PUSH_FIREBASE_SERVICE_ACCOUNT_JSON=
APP_PUSH_OUTBOX_POLL_INTERVAL_MS=5000
APP_PUSH_OUTBOX_BATCH_SIZE=20
APP_PUSH_OUTBOX_MAX_ATTEMPTS=8
APP_PUSH_OUTBOX_MAX_RETRY_DELAY_SECONDS=3600
